<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="36dp"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="2dp"
    android:paddingEnd="8dp"
    android:paddingBottom="2dp">

    <View
        android:id="@+id/indentSpacer"
        android:layout_width="0dp"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/treeChevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Expand or collapse"
        android:scaleType="centerInside"
        android:src="@drawable/ic_tree_expand" />

    <FrameLayout
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="3dp">
        <ImageView
            android:id="@+id/fileIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription=""
            android:scaleType="centerCrop" />
        <ImageView
            android:id="@+id/selectionMark"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="bottom|end"
            android:contentDescription="Selected"
            android:src="@drawable/ic_action_check"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/fileName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:maxLines="1"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/fileDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="11sp" />
</LinearLayout>